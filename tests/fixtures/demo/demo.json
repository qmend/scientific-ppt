      "title": "状态估计的数学表达",
      "blocks": [
        {
          "type": "equation",
          "latex": "\\hat{x}=\\frac{\\sum_{i=1}^{n}w_i x_i}{\\sum_{i=1}^{n}w_i}",
          "caption": "加权估计量；权重需由研究假设或观测误差确定"
        },
        {
          "type": "equation",
          "latex": "\\Sigma=\\begin{bmatrix}\\sigma_1^2&\\rho\\sigma_1\\sigma_2\\\\\\rho\\sigma_1\\sigma_2&\\sigma_2^2\\end{bmatrix}",
          "caption": "协方差矩阵保留通道之间的相关性"
        }
      ]
    },
